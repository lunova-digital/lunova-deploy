#!/usr/bin/env python3
"""lunova-shell: forced command for the deploy key. No shell, no PTY, two allowed commands:
  lunova-site <args...>                      the deploy helper
  rsync --server ... . /srv/sites/<site>/releases/<id>/   upload of a release
Anything else is refused. Installed as /usr/local/bin/lunova-shell, used via
authorized_keys: restrict,command="/usr/local/bin/lunova-shell" <key>
"""
import os, re, shlex, sys

cmd = os.environ.get("SSH_ORIGINAL_COMMAND", "")


def deny(why):
    print(f"lunova-shell: refused ({why})", file=sys.stderr); sys.exit(126)


try:
    argv = shlex.split(cmd)
except ValueError:
    deny("unparseable")
if not argv:
    deny("interactive shells are not allowed")

if argv[0] == "lunova-site":
    os.execv("/usr/local/bin/lunova-site", ["lunova-site"] + argv[1:])

if argv[0] == "rsync" and len(argv) >= 4 and argv[1] == "--server":
    ok_long = {"--delete", "--delete-excluded", "--mkpath", "--delete-before", "--delete-during", "--delete-after"}
    dest = argv[-1]
    for a in argv[2:-2]:
        if not (re.fullmatch(r"-[A-Za-z0-9.=,]+", a) or a in ok_long):
            deny(f"rsync option {a}")
    if argv[-2] != ".":
        deny("rsync source")
    if not re.fullmatch(r"/srv/sites/[a-z][a-z0-9-]{1,40}/releases/[A-Za-z0-9._-]{1,64}/?", dest) or ".." in dest:
        deny("rsync destination")
    os.execv("/usr/bin/rsync", ["rsync"] + argv[1:])

deny("command not allowed")
