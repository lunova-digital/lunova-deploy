                            root=a.root or old.get("root"), database=old.get("database"), package=old.get("packages"), php=a.php or old.get("php"),
                            queue=old.get("queue"), scheduler=old.get("scheduler"), health_path=a.health_path or old.get("health_path") or "/",
                            hook=old.get("hooks") if old else None, http_only=False, image=None, container_port=None, host_port=None,
                            public_host=None, public_path=None, public_user=None, env=None, volume=None, memory=512,
                            tenancy_json=a.tenancy_json, seeders_json=a.seeders_json, tasks_json=a.tasks_json)
    cmd_register(ns)
    say(f"tenancy ready: {ten['platform_host']} and {wildcard_host(ten) if ten['wildcard'] else '(no wildcard)'} serve one app root")
    result(ok=True, site=a.site, platform_host=ten["platform_host"], wildcard=ten["wildcard"])


