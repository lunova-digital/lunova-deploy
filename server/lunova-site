#!/usr/bin/env python3
"""lunova-site: register, release, check and roll back sites on the Lunova server.

Runs as the unprivileged `deploy` user. Only privileged action: sudo caddy-reload.
Layout: /srv/sites/<site>/{releases/<id>,current,shared}, /etc/caddy/sites/<site>.caddy,
        ~/.config/systemd/user/site-<site>.service, /srv/registry/sites/<site>.json
All output is human readable; machine-readable results are printed as a final `RESULT {json}` line.
"""
import argparse, hashlib, ipaddress, json, os, re, secrets, shutil, socket, subprocess, sys, time, urllib.request
from pathlib import Path

# Verified caller identity, exported by lunova-gate from the GitHub OIDC token. Unset when ops run this directly.
WHO = os.environ.get("LUNOVA_REPO") or None
REF = os.environ.get("LUNOVA_REF") or ""

SITES = Path("/srv/sites"); REG = Path("/srv/registry"); CADDY = Path("/etc/caddy/sites")
UNITS = Path.home() / ".config/systemd/user"
NAME_RE = re.compile(r"^[a-z][a-z0-9-]{1,40}$")
HOST_RE = re.compile(r"^(?=.{1,253}$)([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,}$")
ID_RE = re.compile(r"^[A-Za-z0-9._-]{1,64}$")
TYPES = ("static", "spa", "node", "python", "laravel")
RESERVED = {"default", "caddy", "registry", "lunova", "admin", "root", "deploy", "ops"}
KEEP = 3
CLOUDFLARE = [ipaddress.ip_network(n) for n in (
    "173.245.48.0/20", "103.21.244.0/22", "103.22.200.0/22", "103.31.4.0/22", "141.101.64.0/18", "108.162.192.0/18",
    "190.93.240.0/20", "188.114.96.0/20", "197.234.240.0/22", "198.41.128.0/17", "162.158.0.0/15", "104.16.0.0/13",
    "104.24.0.0/14", "172.64.0.0/13", "131.0.72.0/22")]
DB_KEYS = ("DB_CONNECTION", "DB_HOST", "DB_PORT", "DB_DATABASE", "DB_USERNAME", "DB_PASSWORD")
PORTS = range(3100, 4000)
DEFAULT_HOOKS = {
    "laravel": ["php artisan migrate --force", "php artisan config:cache", "php artisan route:cache",
                "php artisan view:cache", "php artisan event:cache", "php artisan storage:link --force"],
    "node": ["npm ci --omit=dev"],
    "python": ["python3 -m venv .venv", ".venv/bin/pip install -q -r requirements.txt"],
}


def die(msg, code=1):
    print(f"ERROR: {msg}", file=sys.stderr); sys.exit(code)


def say(msg): print(msg, flush=True)


def result(**kw): print("RESULT " + json.dumps(kw, sort_keys=True))


def run(cmd, cwd=None, check=True, shell=False, env=None):
    p = subprocess.run(cmd, cwd=cwd, shell=shell, text=True, capture_output=True, env=env)
    if check and p.returncode != 0:
        die(f"command failed ({p.returncode}): {cmd if shell else ' '.join(cmd)}\n{p.stdout}{p.stderr}")
    return p


def cfg():
    p = REG / "config.json"
    return json.loads(p.read_text()) if p.exists() else {}


def check_name(n):
    if not NAME_RE.match(n or "") or n in RESERVED:
        die(f"invalid site name '{n}': use lowercase letters, digits, hyphens (2-41 chars), not reserved")


def reg_path(site): return REG / "sites" / f"{site}.json"


def load(site, write=False):
    """Load a site. Through the gate, only the repo the site is bound to may touch it; changes only from its deploy branch."""
    p = reg_path(site)
    if not p.exists(): die(f"site '{site}' is not registered (run: lunova-site register ...)")
    d = json.loads(p.read_text())
    if WHO:
        if d.get("repo") != WHO: die(f"site '{site}' belongs to another repository")
        if write and d.get("branch") and REF != f"refs/heads/{d['branch']}":
            die(f"site '{site}' deploys from branch '{d['branch']}' only (this run is {REF or 'unknown'})")
    return d


def save(site, data):
    (REG / "sites").mkdir(parents=True, exist_ok=True)
    tmp = reg_path(site).with_suffix(".tmp"); tmp.write_text(json.dumps(data, indent=2, sort_keys=True)); tmp.replace(reg_path(site))


def all_sites():
    d = REG / "sites"
    return {p.stem: json.loads(p.read_text()) for p in sorted(d.glob("*.json"))} if d.exists() else {}


def listening_ports():
    out = run(["ss", "-ltnH"], check=False).stdout
    return {int(m.group(1)) for m in re.finditer(r":(\d+)\s", out)}


def caddy_reload(): run(["sudo", "-n", "/usr/local/sbin/caddy-reload"])


def php_socket(): return cfg().get("php_socket", "/run/php/lunova.sock")


def render_caddy(site, d):
    hosts = ", ".join((f"http://{h}" if d.get("http_only") else h) for h in d["domains"])
    cur = f"/srv/sites/{site}/current"
    t = d["type"]
    if t in ("static", "spa"):
        body = f"\troot * {cur}/{d.get('root', '').strip('/')}".rstrip("/") + "\n\tencode zstd gzip\n"
        if t == "spa": body += "\ttry_files {path} /index.html\n"
        body += "\tfile_server\n"
    elif t in ("node", "python"):
        body = f"\tencode zstd gzip\n\treverse_proxy 127.0.0.1:{d['port']}\n"
    else:  # laravel
        body = (f"\troot * {cur}/public\n\tencode zstd gzip\n\tphp_fastcgi unix/{php_socket()} {{\n"
                f"\t\tresolve_root_symlink\n\t}}\n\tfile_server\n")
    return f"# managed by lunova-site (site: {site}, repo: {d.get('repo', '-')})\n{hosts} {{\n{body}}}\n"


def render_unit(site, d):
    start = d["start"]
    return (f"[Unit]\nDescription=Lunova site {site}\nAfter=network.target\n\n[Service]\n"
            f"WorkingDirectory=/srv/sites/{site}/current\nEnvironmentFile=-/srv/sites/{site}/shared/.env\n"
            f"Environment=PORT={d['port']} HOST=127.0.0.1\nExecStart=/usr/bin/bash -c 'exec {start}'\n"
            f"Restart=on-failure\nRestartSec=3\n\n[Install]\nWantedBy=default.target\n")


def render_queue_unit(site):
    return (f"[Unit]\nDescription=Lunova queue worker {site}\nAfter=network.target\n\n[Service]\n"
            f"WorkingDirectory=/srv/sites/{site}/current\n"
            "ExecStart=/usr/bin/php artisan queue:work --sleep=3 --tries=3 --max-time=3600\n"
            "Restart=always\nRestartSec=3\nMemoryMax=300M\n\n[Install]\nWantedBy=default.target\n")


def render_schedule_units(site):
    svc = (f"[Unit]\nDescription=Lunova scheduler tick {site}\n\n[Service]\nType=oneshot\n"
           f"WorkingDirectory=/srv/sites/{site}/current\nExecStart=/usr/bin/php artisan schedule:run\n")
    tmr = (f"[Unit]\nDescription=Lunova scheduler {site} (every minute)\n\n[Timer]\nOnCalendar=*-*-* *:*:00\n"
           "AccuracySec=1s\n\n[Install]\nWantedBy=timers.target\n")
    return svc, tmr


def sync_workers(site, d):
    """Create/remove the queue worker and scheduler timer according to the registry (laravel only)."""
    UNITS.mkdir(parents=True, exist_ok=True)
    q, sch = UNITS / f"site-{site}-queue.service", UNITS / f"site-{site}-schedule.service"
    tm = UNITS / f"site-{site}-schedule.timer"
    if d.get("queue") and d["type"] == "laravel":
        q.write_text(render_queue_unit(site)); run(["systemctl", "--user", "enable", q.name], check=False)
    elif q.exists():
        run(["systemctl", "--user", "disable", "--now", q.name], check=False); q.unlink()
    if d.get("scheduler") and d["type"] == "laravel":
        svc, tmr = render_schedule_units(site); sch.write_text(svc); tm.write_text(tmr)
        run(["systemctl", "--user", "enable", tm.name], check=False)
    elif tm.exists():
        run(["systemctl", "--user", "disable", "--now", tm.name], check=False); tm.unlink(missing_ok=True); sch.unlink(missing_ok=True)
    run(["systemctl", "--user", "daemon-reload"])


def provision(pkgs):
    """Install packages this project needs (root helper validates names; nothing outside deployment tooling)."""
    pkgs = sorted(set(pkgs))
    if not pkgs: return
    say(f"provisioning packages: {' '.join(pkgs)}")
    p = run(["sudo", "-n", "/usr/local/sbin/lunova-provision", "install", *pkgs], check=False)
    if p.returncode != 0: die(f"could not install {' '.join(pkgs)}:\n{p.stdout}{p.stderr}")
    say(p.stdout.strip())


DB_PHP_EXT = {"mysql": "php8.3-mysql", "postgres": "php8.3-pgsql", "sqlite": "php8.3-sqlite3"}
# composer "ext-*" -> Ubuntu package. Core/always-present extensions are not listed.
EXT_PKG = {"mbstring": "php8.3-mbstring", "xml": "php8.3-xml", "dom": "php8.3-xml", "simplexml": "php8.3-xml", "xmlreader": "php8.3-xml",
           "xmlwriter": "php8.3-xml", "curl": "php8.3-curl", "zip": "php8.3-zip", "gd": "php8.3-gd", "intl": "php8.3-intl",
           "bcmath": "php8.3-bcmath", "pdo_mysql": "php8.3-mysql", "mysqli": "php8.3-mysql", "mysqlnd": "php8.3-mysql",
           "pdo_pgsql": "php8.3-pgsql", "pgsql": "php8.3-pgsql", "pdo_sqlite": "php8.3-sqlite3", "sqlite3": "php8.3-sqlite3",
           "redis": "php8.3-redis", "imagick": "php8.3-imagick", "gmp": "php8.3-gmp", "soap": "php8.3-soap", "exif": "php8.3-common",
           "opcache": "php8.3-opcache", "ldap": "php8.3-ldap", "imap": "php8.3-imap", "memcached": "php8.3-memcached", "apcu": "php8.3-apcu"}


def ensure_runtime(site, d, rel):
    """Before hooks run: make sure the server can actually run this release (extensions, DB engine, declared packages)."""
    pkgs = list(d.get("packages", []))
    if d["type"] == "laravel":
        if d.get("database") in DB_PHP_EXT: pkgs.append(DB_PHP_EXT[d["database"]])
        if (rel / "composer.lock").exists() and shutil.which("composer"):
            p = run(["composer", "check-platform-reqs", "--no-dev", "--format=json", "--no-interaction"], cwd=rel, check=False)
            try: rows = json.loads(p.stdout or "[]")
            except ValueError: rows = []
            for r in rows:
                if r.get("status") != "missing" or not str(r.get("name", "")).startswith("ext-"): continue
                ext = r["name"][4:]
                if ext in EXT_PKG: pkgs.append(EXT_PKG[ext])
                else: die(f"the project needs PHP extension '{ext}' which Lunova does not know how to install. Add the apt package to `packages:` in .lunova.yml.")
    if d.get("database") == "postgres": pkgs += ["postgresql", "postgresql-client"]
    provision(pkgs)


def ensure_db(site, engine):
    """DB credentials are generated server-side and kept in shared/db.env (0600). Developers never see or choose them."""
    shared = SITES / site / "shared"; shared.mkdir(parents=True, exist_ok=True)
    if engine == "sqlite":
        f = shared / "database.sqlite"; f.touch(mode=0o600)
        out = f"DB_CONNECTION=sqlite\nDB_DATABASE={f}\n"
    else:
        if engine == "postgres": provision(["postgresql", "postgresql-client"])
        out = run(["sudo", "-n", "/usr/local/sbin/lunova-db", "ensure", site]).stdout
    tmp = shared / "db.env.tmp"; fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f: f.write(out)
    tmp.replace(shared / "db.env")


def parse_env(text):
    """Ordered {KEY: raw value} of an env file (comments and blank lines are dropped)."""
    out = {}
    for l in text.splitlines():
        m = re.match(r"^\s*(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)\s*=(.*)$", l)
        if m: out[m.group(1)] = m.group(2)
    return out


def dump_env(kv): return "".join(f"{k}={v}\n" for k, v in kv.items())


def env_quote(v):
    return v if re.fullmatch(r"[A-Za-z0-9_./:@%+,=-]*", v) else '"' + v.replace("\\", "\\\\").replace('"', '\\"').replace("$", "\\$").replace("\n", "\\n") + '"'


def write_secret(path, text):
    tmp = path.with_name(path.name + ".tmp"); fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f: f.write(text)
    tmp.replace(path)


def seed_env(site, d, rel):
    """First/every release: add what the app needs but nobody has set yet. Existing values are never overwritten.
    Order of precedence: values the developer sealed > server defaults > the repo's .env.example."""
    shared = SITES / site / "shared"; base = shared / ".env.base"
    kv = parse_env(base.read_text()) if base.exists() else {}
    if d["type"] == "laravel":
        scheme = "http" if d.get("http_only") else "https"
        defaults = {"APP_ENV": "production", "APP_DEBUG": "false", "APP_URL": f"{scheme}://{d['domains'][0]}"}
        for k, v in defaults.items(): kv.setdefault(k, v)
    ex = rel / ".env.example"
    if ex.exists():
        for k, v in parse_env(ex.read_text()).items(): kv.setdefault(k, v)
    if d["type"] == "laravel" and not kv.get("APP_KEY"):
        kv["APP_KEY"] = "base64:" + __import__("base64").b64encode(secrets.token_bytes(32)).decode()
    if kv: write_secret(base, dump_env(kv))


def build_env(site):
    """shared/.env = shared/.env.base (defaults + sealed values) with DB_* overridden by shared/db.env."""
    shared = SITES / site / "shared"; base, dbf = shared / ".env.base", shared / "db.env"
    if not base.exists() and not dbf.exists(): return False
    kv = parse_env(base.read_text()) if base.exists() else {}
    if dbf.exists():
        for k in DB_KEYS: kv.pop(k, None)
        kv.update(parse_env(dbf.read_text()))
    write_secret(shared / ".env", dump_env(kv)); return True


def cmd_capabilities(a):
    def ver(c, flag="--version"):
        p = run([c, flag], check=False) if shutil.which(c) else None
        return p.stdout.splitlines()[0].strip() if p and p.stdout else None
    caps = {
        "node": ver("node"), "npm": ver("npm"), "python3": ver("python3"), "php": ver("php"), "composer": ver("composer"),
        "php_fpm_socket": php_socket() if os.path.exists(php_socket()) else None,
        "mysql_client": bool(shutil.which("mysql")), "postgres_client": bool(shutil.which("psql")),
        "disk_free_gb": round(shutil.disk_usage("/srv").free / 1e9, 1),
        "sites": sorted(s for s, d in all_sites().items() if not WHO or d.get("repo") == WHO), "public_ip": cfg().get("public_ip"),
    }
    for k, v in caps.items(): say(f"{k}: {v}")
    result(ok=True, capabilities=caps)


def cmd_check_domain(a):
    ip = cfg().get("public_ip"); bad = []
    for h in a.domains:
        h = h.lower()
        if not HOST_RE.match(h): bad.append((h, "invalid hostname")); continue
        owner = next((s for s, d in all_sites().items() if h in d["domains"] and s != a.site), None)
        if owner: bad.append((h, f"already used by site '{owner}'")); continue
        try: res = socket.gethostbyname(h)
        except OSError: bad.append((h, "does not resolve (create DNS A record)")); continue
        if ip and res != ip:
            if any(ipaddress.ip_address(res) in n for n in CLOUDFLARE):
                say(f"OK (Cloudflare proxy) {h} -> {res}: origin cannot be verified. Make sure the Cloudflare record points to {ip}; "
                    "for the FIRST certificate set the record to DNS-only (grey cloud), then re-enable the proxy and use SSL mode Full (strict).")
            else: bad.append((h, f"points to {res}, expected {ip}"))
        else: say(f"OK {h} -> {res}")
    for h, why in bad: say(f"PROBLEM {h}: {why}")
    result(ok=not bad, problems=[{"domain": h, "problem": w} for h, w in bad])
    sys.exit(0 if not bad else 2)


def cmd_register(a):
    check_name(a.site)
    if a.type not in TYPES: die(f"type must be one of {', '.join(TYPES)}")
    domains = [h.lower() for h in a.domains.split(",") if h.strip()]
    if not domains: die("at least one domain is required")
    for h in domains:
        if not HOST_RE.match(h): die(f"invalid domain '{h}'")
    sites = all_sites(); old = sites.get(a.site)
    if WHO:  # through the gate: identity comes from the OIDC token, never from arguments
        a.repo = WHO
        if not REF.startswith("refs/heads/"): die("sites can only be registered from a branch push (not a PR or tag)")
    branch = REF.removeprefix("refs/heads/") if WHO else (old or {}).get("branch")
    if old and a.repo and old.get("repo") and old["repo"] != a.repo:
        die(f"site '{a.site}' belongs to repo {old['repo']}, not {a.repo}")
    if old and WHO and old.get("branch") and old["branch"] != branch:
        die(f"site '{a.site}' deploys from branch '{old['branch']}' only. To move it to '{branch}', ask Lunova ops.")
    pkgs = []
    for x in a.package or []:
        if not re.fullmatch(r"[a-z0-9][a-z0-9.+-]{1,60}", x): die(f"invalid package name '{x}'")
        pkgs.append(x)
    for h in domains:
        for s, d in sites.items():
            if s != a.site and h in d["domains"]: die(f"domain {h} is already used by site '{s}'")
    if a.type == "laravel" and not os.path.exists(php_socket()):
        die(f"PHP-FPM socket {php_socket()} not found: ops must set up PHP-FPM first (see ops request: laravel)")
    d = {"site": a.site, "type": a.type, "domains": domains, "repo": a.repo or (old or {}).get("repo"),
         "root": a.root or "", "http_only": bool(a.http_only), "health_path": a.health_path,
         "hooks": a.hook if a.hook is not None else DEFAULT_HOOKS.get(a.type, []),
         "database": a.database, "queue": bool(a.queue), "scheduler": bool(a.scheduler), "packages": sorted(set(pkgs)),
         "branch": branch}
    if (a.queue or a.scheduler) and a.type != "laravel": die("--queue/--scheduler are only supported for laravel sites")
    if a.type in ("node", "python"):
        if not a.start and not (old and old.get("start")): die("--start is required for node/python sites")
        start = a.start or old["start"]
        if re.search(r"['\n%\r]", start): die("start command must not contain ', %, or newlines")
        d["start"] = start
        used = {x.get("port") for s, x in sites.items() if s != a.site}
        d["port"] = (old or {}).get("port") or next((p for p in PORTS if p not in used and p not in listening_ports()), None)
        if not d["port"]: die("no free port available")
    base = SITES / a.site
    for sub in ("releases", "shared"): (base / sub).mkdir(parents=True, exist_ok=True)
    CADDY.mkdir(parents=True, exist_ok=True)
    (CADDY / f"{a.site}.caddy").write_text(render_caddy(a.site, d))
    if a.type in ("node", "python"):
        UNITS.mkdir(parents=True, exist_ok=True)
        (UNITS / f"site-{a.site}.service").write_text(render_unit(a.site, d))
        run(["systemctl", "--user", "daemon-reload"])
        run(["systemctl", "--user", "enable", f"site-{a.site}.service"], check=False)
    save(a.site, d)
    if d["database"]: ensure_db(a.site, d["database"]); build_env(a.site)
    sync_workers(a.site, d)
    try: caddy_reload()
    except SystemExit:
        (CADDY / f"{a.site}.caddy").unlink(missing_ok=True); raise
    say(f"registered {a.site} ({a.type}) -> {', '.join(domains)}" + (f" on port {d['port']}" if d.get("port") else "")
        + (" +db" if d["database"] else "") + (" +queue" if d["queue"] else "") + (" +scheduler" if d["scheduler"] else ""))
    result(ok=True, site=a.site, type=a.type, domains=domains, port=d.get("port"), updated=bool(old))


def releases(site):
    d = SITES / site / "releases"
    return sorted((p for p in d.iterdir() if p.is_dir()), key=lambda p: p.stat().st_mtime) if d.exists() else []


def ok_ts(rel):
    """Epoch when a release passed its health check (marker written only on success), else None."""
    m = Path(rel) / ".lunova-ok"
    try: return int(m.read_text().strip())
    except (OSError, ValueError): return None


def current_target(site):
    cur = SITES / site / "current"
    return os.path.realpath(cur) if cur.is_symlink() else None


def switch(site, rel):
    tmp = SITES / site / ".current.tmp"
    tmp.unlink(missing_ok=True); tmp.symlink_to(rel); os.replace(tmp, SITES / site / "current")


def restart(site, d):
    if d["type"] in ("node", "python"):
        run(["systemctl", "--user", "restart", f"site-{site}.service"])
    if d["type"] == "laravel":
        if d.get("queue"): run(["systemctl", "--user", "restart", f"site-{site}-queue.service"])
        if d.get("scheduler"): run(["systemctl", "--user", "start", f"site-{site}-schedule.timer"])


def health(site, d):
    path = d.get("health_path") or "/"
    if d["type"] in ("node", "python"): url, hdr = f"http://127.0.0.1:{d['port']}{path}", {}
    else: url, hdr = f"http://127.0.0.1{path}", {"Host": d["domains"][0]}

    class NoRedirect(urllib.request.HTTPRedirectHandler):
        def redirect_request(self, *a, **k): return None
    op = urllib.request.build_opener(NoRedirect)
    last = None
    for _ in range(15):
        try:
            return op.open(urllib.request.Request(url, headers=hdr), timeout=5).status, url
        except urllib.error.HTTPError as e:
            last = e.code
            if 200 <= e.code < 400: return e.code, url
        except Exception as e: last = str(e)
        time.sleep(1)
    return last, url


def cmd_release(a):
    check_name(a.site); d = load(a.site, write=True)
    if not ID_RE.match(a.id): die("invalid release id")
    rel = SITES / a.site / "releases" / a.id
    if not rel.is_dir(): die(f"release {rel} not found: upload it first")
    env = SITES / a.site / "shared" / ".env"
    ensure_runtime(a.site, d, rel)
    seed_env(a.site, d, rel)
    build_env(a.site)
    if d["type"] == "laravel":
        shared_storage = SITES / a.site / "shared" / "storage"
        for sub in ("app/public", "framework/cache/data", "framework/sessions", "framework/views", "logs"):
            (shared_storage / sub).mkdir(parents=True, exist_ok=True)
        if (rel / "storage").exists() and not (rel / "storage").is_symlink(): shutil.rmtree(rel / "storage")
        (rel / "storage").unlink(missing_ok=True); (rel / "storage").symlink_to(shared_storage)
        (rel / "bootstrap/cache").mkdir(parents=True, exist_ok=True)
    if env.exists():
        (rel / ".env").unlink(missing_ok=True); (rel / ".env").symlink_to(env)
    prev = current_target(a.site)
    for h in d.get("hooks", []):
        say(f"hook: {h}")
        p = run(["bash", "-c", h], cwd=rel, check=False)
        if p.returncode != 0:
            say(p.stdout + p.stderr); die(f"hook failed: {h} (nothing was switched; the live site is unchanged)")
    switch(a.site, rel)
    restart(a.site, d)
    code, url = health(a.site, d)
    if not (isinstance(code, int) and 200 <= code < 400):
        say(f"health check failed ({code}) at {url}")
        if prev: switch(a.site, prev); restart(a.site, d); say(f"rolled back to {os.path.basename(prev)}")
        result(ok=False, site=a.site, release=a.id, health=str(code), rolled_back=bool(prev)); sys.exit(3)
    (rel / ".lunova-ok").write_text(str(int(time.time())))
    good = sorted((r for r in releases(a.site) if ok_ts(r)), key=ok_ts)
    keep = {str(r) for r in good[-KEEP:]} | {current_target(a.site)}
    for old in releases(a.site):  # also removes failed (unmarked) releases
        if str(old) not in keep: shutil.rmtree(old, ignore_errors=True)
    say(f"released {a.site} {a.id} (health {code})")
    result(ok=True, site=a.site, release=a.id, health=code, domains=d["domains"])


def cmd_rollback(a):
    check_name(a.site); d = load(a.site, write=True)
    cur = current_target(a.site)
    if a.to:
        target = SITES / a.site / "releases" / a.to
        if not ID_RE.match(a.to) or not target.is_dir(): die(f"release {a.to} not found")
    else:
        cts = ok_ts(cur) if cur else None
        older = [r for r in releases(a.site) if ok_ts(r) and (cts is None or ok_ts(r) < cts) and str(r) != cur]
        if not older: die("no earlier successful release to roll back to (use --to <release id>)")
        target = max(older, key=ok_ts)
    switch(a.site, target); restart(a.site, d)
    code, _ = health(a.site, d)
    say(f"rolled back {a.site} to {target.name} (health {code})")
    result(ok=isinstance(code, int) and 200 <= code < 400, site=a.site, release=target.name, health=str(code))


def cmd_status(a):
    check_name(a.site); d = load(a.site); cur = current_target(a.site)
    active = None
    if d["type"] in ("node", "python"):
        active = run(["systemctl", "--user", "is-active", f"site-{a.site}.service"], check=False).stdout.strip()
    code, url = health(a.site, d) if cur else (None, None)
    extra = {}
    if d["type"] == "laravel":
        for unit in ("queue.service", "schedule.timer"):
            if (UNITS / f"site-{a.site}-{unit}").exists():
                extra[unit.split(".")[0]] = run(["systemctl", "--user", "is-active", f"site-{a.site}-{unit}"], check=False).stdout.strip()
    envf = SITES / a.site / "shared" / ".env.base"
    names = {k: ("set" if v.strip().strip("\"'") else "empty") for k, v in parse_env(envf.read_text()).items()} if envf.exists() else {}
    say(json.dumps({**d, "current": os.path.basename(cur) if cur else None, "service": active, "health": code, **extra}, indent=2))
    if names:
        say("env (names only; DB_* are managed by the server):")
        for k, v in sorted(names.items()): say(f"  {k:28s} {v}")
    result(ok=True, site=a.site, current=os.path.basename(cur) if cur else None, service=active, health=str(code), releases=[r.name for r in releases(a.site)])


SEAL_KEY = Path("/var/lib/lunova/seal/private.pem")


def unseal(blob):
    """Sealed file format (3 lines): LUNOVA-SEALED-1 / base64(RSA-OAEP-SHA256(random key)) / base64(openssl enc aes-256-cbc pbkdf2)."""
    import base64
    lines = blob.strip().splitlines()
    if len(lines) != 3 or lines[0] != "LUNOVA-SEALED-1": die("not a Lunova sealed env file")
    try: wrapped = base64.b64decode(lines[1], validate=True)
    except ValueError: die("sealed env file is corrupt")
    k = run_bytes(["openssl", "pkeyutl", "-decrypt", "-inkey", str(SEAL_KEY), "-pkeyopt", "rsa_padding_mode:oaep",
                   "-pkeyopt", "rsa_oaep_md:sha256"], wrapped)
    if k is None: die("sealed env cannot be decrypted (sealed for another server?)")
    r, w = os.pipe(); os.write(w, k.strip() + b"\n"); os.close(w)
    try:
        p = subprocess.run(["openssl", "enc", "-d", "-aes-256-cbc", "-pbkdf2", "-a", "-A", "-pass", f"fd:{r}"], input=lines[2].encode(),
                           capture_output=True, pass_fds=(r,))
    finally: os.close(r)
    if p.returncode != 0: die("sealed env cannot be decrypted (corrupt or tampered)")
    try: return json.loads(p.stdout)
    except ValueError: die("sealed env payload is not valid")


def run_bytes(cmd, data):
    p = subprocess.run(cmd, input=data, capture_output=True)
    return p.stdout if p.returncode == 0 else None


def cmd_apply_env(a):
    """Merge the developer's sealed env patch (stdin) into the site's environment. Idempotent: the same file is applied once."""
    check_name(a.site); d = load(a.site, write=True)
    blob = sys.stdin.read(70000)
    if not blob.strip(): die("empty sealed env on stdin")
    digest = hashlib.sha256(blob.encode()).hexdigest()
    if d.get("env_hash") == digest: say("sealed env unchanged since the last deploy; nothing to apply"); result(ok=True, applied=False); return
    pl = unseal(blob)
    if pl.get("v") != 1 or pl.get("site") != a.site: die("sealed env was made for a different site")
    if WHO and pl.get("repo") != WHO: die("sealed env was made for a different repository")
    sets, unsets = pl.get("set", {}), pl.get("unset", [])
    if not isinstance(sets, dict) or not isinstance(unsets, list): die("sealed env payload is not valid")
    for k, v in sets.items():
        if not re.fullmatch(r"[A-Z][A-Z0-9_]{0,63}", k) or not isinstance(v, str): die(f"invalid env variable '{k}'")
        if k in DB_KEYS: die(f"{k} is managed by the server (database credentials are generated and injected automatically)")
    shared = SITES / a.site / "shared"; shared.mkdir(parents=True, exist_ok=True); base = shared / ".env.base"
    kv = parse_env(base.read_text()) if base.exists() else {}
    for k, v in sets.items(): kv[k] = env_quote(v)
    for k in unsets: kv.pop(k, None)
    write_secret(base, dump_env(kv)); build_env(a.site)
    d["env_hash"] = digest; save(a.site, d)
    say(f"applied sealed env to {a.site}: set {len(sets)}, unset {len(unsets)} ({', '.join(sorted(sets)) or '-'})")
    result(ok=True, applied=True, set=sorted(sets), unset=sorted(unsets))


def cmd_logs(a):
    check_name(a.site); d = load(a.site); n = max(1, min(a.lines, 500))
    say(f"== last {n} lines of app logs for {a.site}")
    logs = sorted((SITES / a.site / "shared" / "storage" / "logs").glob("*.log"), key=lambda p: p.stat().st_mtime) if d["type"] == "laravel" else []
    if logs:
        say(f"-- {logs[-1].name}"); say(run(["tail", "-n", str(n), str(logs[-1])]).stdout)
    for unit in (f"site-{a.site}.service", f"site-{a.site}-queue.service", f"site-{a.site}-schedule.service"):
        if (UNITS / unit).exists():
            p = run(["journalctl", "--user", "-u", unit, "-n", str(n), "--no-pager", "-o", "short"], check=False)
            say(f"-- {unit}"); say(p.stdout.strip() or "(no journal entries)")
    result(ok=True, site=a.site)


def cmd_list(a):
    mine = {s: d for s, d in all_sites().items() if not WHO or d.get("repo") == WHO}
    for s, d in mine.items(): say(f"{s}\t{d['type']}\t{','.join(d['domains'])}\t{d.get('repo', '-')}")
    result(ok=True, sites=sorted(mine))


def cmd_unregister(a):
    check_name(a.site); d = load(a.site, write=True)
    if not a.yes: die("refusing without --yes (this removes the site's Caddy config and service; data in /srv/sites is kept)")
    if d["type"] in ("node", "python"):
        run(["systemctl", "--user", "disable", "--now", f"site-{a.site}.service"], check=False)
        (UNITS / f"site-{a.site}.service").unlink(missing_ok=True); run(["systemctl", "--user", "daemon-reload"])
    d2 = {**d, "queue": False, "scheduler": False}; sync_workers(a.site, d2)
    (CADDY / f"{a.site}.caddy").unlink(missing_ok=True); reg_path(a.site).unlink(); caddy_reload()
    say(f"unregistered {a.site}"); result(ok=True, site=a.site)


def main():
    p = argparse.ArgumentParser(prog="lunova-site"); sp = p.add_subparsers(dest="cmd", required=True)
    sp.add_parser("capabilities").set_defaults(f=cmd_capabilities)
    c = sp.add_parser("check-domain"); c.add_argument("--site", default=""); c.add_argument("domains", nargs="+"); c.set_defaults(f=cmd_check_domain)
    r = sp.add_parser("register"); r.add_argument("--site", required=True); r.add_argument("--type", required=True)
    r.add_argument("--domains", required=True); r.add_argument("--repo"); r.add_argument("--start"); r.add_argument("--root")
    r.add_argument("--database", choices=["mysql", "postgres", "sqlite"]); r.add_argument("--package", action="append")
    r.add_argument("--queue", action="store_true"); r.add_argument("--scheduler", action="store_true")
    r.add_argument("--health-path", default="/"); r.add_argument("--hook", action="append"); r.add_argument("--http-only", action="store_true")
    r.set_defaults(f=cmd_register)
    x = sp.add_parser("release"); x.add_argument("site"); x.add_argument("id"); x.set_defaults(f=cmd_release)
    b = sp.add_parser("rollback"); b.add_argument("site"); b.add_argument("--to"); b.set_defaults(f=cmd_rollback)
    s = sp.add_parser("status"); s.add_argument("site"); s.set_defaults(f=cmd_status)
