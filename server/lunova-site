def ext_pkg(table, key, ver): return table[key].format(v=ver)


def ensure_runtime(site, d, rel):
    """Before hooks run: make sure the server can actually run this release (extensions, DB engine, declared packages)."""
    pkgs = list(d.get("packages", []))
    if d["type"] == "laravel":
        if d.get("database") in DB_PHP_EXT: pkgs.append(ext_pkg(DB_PHP_EXT, d["database"], php_ver(d)))
        if (rel / "composer.lock").exists() and shutil.which("composer"):
            p = run(["composer", "check-platform-reqs", "--no-dev", "--format=json", "--no-interaction"], cwd=rel, check=False, env=php_env(php_ver(d)))
            try: rows = json.loads(p.stdout or "[]")
            except ValueError: rows = []
            for r in rows:
                if r.get("status") != "missing" or not str(r.get("name", "")).startswith("ext-"): continue
                ext = r["name"][4:]
                if ext in EXT_PKG: pkgs.append(ext_pkg(EXT_PKG, ext, php_ver(d)))
                else: die(f"the project needs PHP extension '{ext}' which Lunova does not know how to install. Add the apt package to `packages:` in .lunova.yml.")
    if d.get("database") == "postgres": pkgs += ["postgresql", "postgresql-client"]
    provision(pkgs)


def ensure_db(site, engine):
    """DB credentials are generated server-side and kept in shared/db.env (0600). Developers never see or choose them."""
    shared = SITES / site / "shared"; shared.mkdir(parents=True, exist_ok=True)
    if engine == "sqlite":
        f = shared / "database.sqlite"; f.touch(mode=0o600)
        out = f"DB_CONNECTION=sqlite\nDB_DATABASE={f}\n"
    else:
        if engine == "postgres": provision(["postgresql", "postgresql-client"])
        out = run(["sudo", "-n", "/usr/local/sbin/lunova-db", "ensure", site]).stdout
    tmp = shared / "db.env.tmp"; fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f: f.write(out)
    tmp.replace(shared / "db.env")


def parse_env(text):
    """Ordered {KEY: raw value} of an env file (comments and blank lines are dropped)."""
    out = {}
    for l in text.splitlines():
        m = re.match(r"^\s*(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)\s*=(.*)$", l)
        if m: out[m.group(1)] = m.group(2)
    return out


def dump_env(kv): return "".join(f"{k}={v}\n" for k, v in kv.items())


def env_quote(v):
    return v if re.fullmatch(r"[A-Za-z0-9_./:@%+,=-]*", v) else '"' + v.replace("\\", "\\\\").replace('"', '\\"').replace("$", "\\$").replace("\n", "\\n") + '"'


def write_secret(path, text):
    tmp = path.with_name(path.name + ".tmp"); fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f: f.write(text)
    tmp.replace(path)


def seed_env(site, d, rel):
    """First/every release: add what the app needs but nobody has set yet. Existing values are never overwritten.
    Order of precedence: values the developer sealed > server defaults > the repo's .env.example."""
    shared = SITES / site / "shared"; base = shared / ".env.base"
    kv = parse_env(base.read_text()) if base.exists() else {}
    if d["type"] == "laravel":
        scheme = "http" if d.get("http_only") else "https"
        defaults = {"APP_ENV": "production", "APP_DEBUG": "false", "APP_URL": f"{scheme}://{d['domains'][0]}"}
        for k, v in defaults.items(): kv.setdefault(k, v)
    ex = rel / ".env.example"
    if ex.exists():
        for k, v in parse_env(ex.read_text()).items(): kv.setdefault(k, v)
    if d["type"] == "laravel" and not kv.get("APP_KEY"):
        kv["APP_KEY"] = "base64:" + __import__("base64").b64encode(secrets.token_bytes(32)).decode()
    if kv: write_secret(base, dump_env(kv))


def build_env(site):
    """shared/.env = shared/.env.base (defaults + sealed values) with DB_* overridden by shared/db.env."""
    shared = SITES / site / "shared"; base, dbf = shared / ".env.base", shared / "db.env"
    if not base.exists() and not dbf.exists(): return False
    kv = parse_env(base.read_text()) if base.exists() else {}
    if dbf.exists():
        for k in DB_KEYS: kv.pop(k, None)
        kv.update(parse_env(dbf.read_text()))
    write_secret(shared / ".env", dump_env(kv)); return True


# --- v10: manifest extras (tenancy, seeders, tasks): pure validators, unit-tested without a server ------------------------------------
def parse_tenancy(t):
    """The manifest's `tenancy:` block -> normalized dict (or None). Strict: unknown keys are an error so a typo can't silently disable it."""
    if t in (None, {}, ""): return None
    if not isinstance(t, dict): die("tenancy must be a map")
    unknown = set(t) - {"root_domain", "platform_host", "wildcard", "tls_cert"}
    if unknown: die(f"unknown tenancy key(s): {', '.join(sorted(unknown))}")
    root = str(t.get("root_domain") or "").lower(); plat = str(t.get("platform_host") or "").lower()
    if not HOST_RE.match(root): die(f"tenancy.root_domain '{root}' is not a valid domain")
    if not HOST_RE.match(plat) or not (plat == root or plat.endswith("." + root)):
        die(f"tenancy.platform_host '{plat}' must be root_domain or a name under it")
    wild = t.get("wildcard", False)
    if not isinstance(wild, bool): die("tenancy.wildcard must be true or false")
    cert = t.get("tls_cert")
    if cert is not None and not CERT_RE.match(str(cert)): die(f"tenancy.tls_cert '{cert}' is not a valid certificate name")
    if wild and not cert: die("tenancy.wildcard needs tenancy.tls_cert (a wildcard cannot be issued automatically: install an origin certificate)")
    return {"root_domain": root, "platform_host": plat, "wildcard": wild, "tls_cert": str(cert) if cert else None}


def wildcard_host(ten): return f"*.{ten['root_domain']}"


def build_domains(listed, ten):
    """The final host list. HOST_RE for ordinary names; exactly one `*.<root_domain>` and only when tenancy.wildcard + tls_cert are set.
    With tenancy the platform host comes first (health check and APP_URL use domains[0]) and the wildcard last."""
    out = []
    for h in listed:
        h = h.lower().strip()
        if not h: continue
        if h.startswith("*."):
            if not (ten and ten["wildcard"] and ten["tls_cert"]): die(f"wildcard host '{h}' needs tenancy.wildcard: true and tenancy.tls_cert")
            if h != wildcard_host(ten): die(f"the only wildcard allowed is {wildcard_host(ten)} (got '{h}')")
            if not WILDCARD_RE.match(h): die(f"invalid wildcard host '{h}'")
        elif not HOST_RE.match(h): die(f"invalid domain '{h}'")
        if h not in out: out.append(h)
    if ten:
        out = [h for h in out if h != ten["platform_host"] and not h.startswith("*.")]
        out = [ten["platform_host"], *out] + ([wildcard_host(ten)] if ten["wildcard"] else [])
    return out


def parse_seeders(v):
    if v is None: return None
    if not isinstance(v, list) or len(v) > 30: die("seeders must be a short list of class names")
    for c in v:
        if not isinstance(c, str) or not SEEDER_RE.match(c): die(f"invalid seeder class '{c}'")
    return list(dict.fromkeys(v))


def parse_tasks(v):
    """tasks: {name: "artisan-command arg {placeholder} ..."}. Tokens only, never a shell. Placeholders from VALUE_RES only."""
    if v is None: return None
    if not isinstance(v, dict) or len(v) > 20: die("tasks must be a small map of name -> command")
    out = {}
    for name, tpl in v.items():
        if not TASK_NAME_RE.match(str(name)): die(f"invalid task name '{name}'")
        if not isinstance(tpl, str) or len(tpl) > 300: die(f"task '{name}' must be a string")
        try: toks = shlex.split(tpl)
        except ValueError: die(f"task '{name}' cannot be parsed")
        if not toks or not TASK_CMD_RE.match(toks[0]): die(f"task '{name}': the first word must be an artisan command like access:super-admin")
        for tok in toks[1:]:
            if not TASK_TOKEN_RE.match(tok): die(f"task '{name}': '{tok}' has characters that are not allowed")
        for ph in PLACEHOLDER_RE.findall(tpl):
            if ph not in VALUE_RES: die(f"task '{name}': unknown placeholder {{{ph}}} (allowed: {', '.join(sorted(VALUE_RES))})")
        if re.sub(PLACEHOLDER_RE, "", tpl).count("{") or re.sub(PLACEHOLDER_RE, "", tpl).count("}"): die(f"task '{name}': stray brace")
        out[name] = " ".join(toks)
    return out


def expand_task(tpl, values):
    """Task template + validated values -> an argv list for `php artisan` (no shell is ever involved)."""
    out = []
    for tok in shlex.split(tpl):
        def sub(m):
            k = m.group(1); v = values.get(k)
            if v is None: die(f"task needs a value for {{{k}}}")
            if not VALUE_RES[k].match(v) or v.startswith("-"): die(f"invalid value for {{{k}}}")
            return v
        out.append(PLACEHOLDER_RE.sub(sub, tok))
    return out


def parse_args_kv(items):
    out = {}
    for kv in items or []:
        k, sep, v = kv.partition("=")
        if not sep or k not in VALUE_RES: die(f"bad --arg '{k}' (allowed: {', '.join(sorted(VALUE_RES))})")
        out[k] = v
    return out


URL_RE = re.compile(r"https?://\S+"); TOKEN_RE = re.compile(r"[A-Za-z0-9_\-+/=%.]{28,}")


def redact(text):
    """Anything that looks like a link or a long token is removed before output leaves the server (invite / set-password links)."""
    return TOKEN_RE.sub("<redacted>", URL_RE.sub("<link redacted>", text or ""))


# --- v10: privileged modes: identity policy, audit line, root helper ------------------------------------------------------------------
def audit(mode, site, result):
    """One line per privileged action: who, what, where, when. Written best-effort (never blocks the action)."""
    clean = lambda v: re.sub(r"[^\w.@:/+()-]", "_", str(v or "-"))[:120]
    line = f"{time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())} actor={clean(ACTOR)} repo={clean(WHO)} ref={clean(REF)} mode={clean(mode)} site={clean(site)} result={clean(result)}\n"
    try:
        with open(REG / "audit.log", "a") as f: f.write(line)
    except OSError: pass


def authorize_mode(mode, site, confirm):
    """Identity gate for a mode, on top of the gate's owner/workflow check: event, GitHub environment, typed confirmation, repo+branch binding."""
    pol = MODE_POLICY[mode]
    if reg_path(site).exists(): load(site, write=True)         # repo and deploy branch (not for a first tenancy-setup: the site is bound there)
    elif mode != "tenancy-setup": die(f"site '{site}' is not registered")
    if WHO:  # through the gate: identity comes from the OIDC token
        if EVENT not in pol["events"]: die(f"mode '{mode}' runs only from a manual workflow run (this was a '{EVENT or 'unknown'}' event)")
        if pol["env"] and ENVIRONMENT != pol["env"]:
            die(f"mode '{mode}' must run in the GitHub environment '{pol['env']}' (with required reviewers); this run was in '{ENVIRONMENT or 'none'}'")
        if mode == "tenancy-setup" and not reg_path(site).exists() and not REF.startswith("refs/heads/"): die("run from a branch")
    if pol["confirm"] and confirm != site: die(f"confirmation does not match: type the site name '{site}' exactly")


def moded(mode):
    """Command wrapper: authorize by MODE_POLICY, then write start/result audit lines."""
    def deco(fn):
        def wrapper(a):
            check_name(a.site)
            try: authorize_mode(mode, a.site, getattr(a, "confirm", None))
            except SystemExit: audit(mode, a.site, "DENIED"); raise
            audit(mode, a.site, "start")
            try: fn(a)
            except SystemExit as e:
                audit(mode, a.site, "ok" if e.code in (0, None) else f"FAIL({e.code})"); raise
            audit(mode, a.site, "ok")
        return wrapper
    return deco


def priv(*args, data=None, check=True):
    """The ONE root helper (narrow sudoers rule). Secrets go in on stdin, never argv."""
    p = subprocess.run(["sudo", "-n", PRIV, *args], input=data, text=True, capture_output=True)
    if check and p.returncode != 0: die(f"privileged helper failed ({args[0]}): {(p.stdout + p.stderr).strip()[-800:]}")
    return p


def need_laravel(d):
    if d["type"] != "laravel": die("this mode runs `php artisan`: it needs a laravel site")
    if not (SITES / d["site"] / "current").exists(): die("no release is live yet: deploy first")


def artisan(d, *args, check=True):
    """`php artisan ...` in the live release as the site's PHP version. argv list, never a shell."""
    ver = php_ver(d); cur = SITES / d["site"] / "current"
    return run([php_bin(ver), "artisan", *args], cwd=cur, check=check, env=php_env(ver))


# --- backup ----------------------------------------------------------------------------------------------------------------------
def do_backup(d):
    """Dump the site's database to /srv/backups/<site>/ (mysql or sqlite), prove it is a readable gzip, return path/size/sha256. Never uploaded."""
    site = d["site"]; engine = d.get("database")
    if engine not in ("mysql", "sqlite"): die(f"backup supports mysql and sqlite sites (this site uses '{engine}'): refusing rather than pretend")
    priv("ensure-backup-dir", site)
    ts = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())
    final = BACKUPS / site / f"{site}-{ts}.{'sql' if engine == 'mysql' else 'sqlite'}.gz"; tmp = final.with_name(final.name + ".part")
    dbenv = parse_env((SITES / site / "shared" / "db.env").read_text()) if (SITES / site / "shared" / "db.env").exists() else {}
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    try:
        with os.fdopen(fd, "wb") as raw, gzip.GzipFile(fileobj=raw, mode="wb") as gz:
            if engine == "mysql":
                for k in ("DB_HOST", "DB_PORT", "DB_DATABASE", "DB_USERNAME", "DB_PASSWORD"):
                    if not dbenv.get(k): die(f"{k} is missing from the site's database settings")
                cmd = ["mysqldump", "--single-transaction", "--quick", "--routines", "--triggers", "--no-tablespaces",
                       "-h", dbenv["DB_HOST"], "-P", dbenv["DB_PORT"], "-u", dbenv["DB_USERNAME"], dbenv["DB_DATABASE"]]
                p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, env={**os.environ, "MYSQL_PWD": dbenv["DB_PASSWORD"]})
                last = b""
                for chunk in iter(lambda: p.stdout.read(1 << 16), b""): gz.write(chunk); last = (last + chunk)[-300:]
                err = p.stderr.read().decode(errors="replace"); rc = p.wait()
                if rc != 0: die(f"mysqldump failed ({rc}): {err.strip()[-500:]}")
                if b"Dump completed" not in last: die("mysqldump output looks truncated (no completion marker): refusing to call it a backup")
            else:
                src = Path(dbenv.get("DB_DATABASE") or SITES / site / "shared" / "database.sqlite")
                mem = Path(str(tmp) + ".db"); a, b = sqlite3.connect(f"file:{src}?mode=ro", uri=True), sqlite3.connect(mem)
                try: a.backup(b)
                finally: a.close(); b.close()
                gz.write(mem.read_bytes()); mem.unlink()
        g = subprocess.run(["gzip", "-t", str(tmp)], capture_output=True, text=True)
        if g.returncode != 0: die(f"gzip -t failed: {g.stderr.strip()}")
        tmp.replace(final)
    except BaseException:
        tmp.unlink(missing_ok=True); raise
    h = hashlib.sha256()
    with open(final, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""): h.update(chunk)
    return {"path": str(final), "size": final.stat().st_size, "sha256": h.hexdigest()}


@moded("backup")
def cmd_backup(a):
    d = load(a.site)
    b = do_backup(d)
    say(f"backup written: {b['path']}  size={b['size']} bytes  sha256={b['sha256']}  (kept on this server only; never uploaded)")
    result(ok=True, site=a.site, **b)


# --- reset-db ----------------------------------------------------------------------------------------------------------------------
@moded("reset-db")
def cmd_reset_db(a):
    d = load(a.site); need_laravel(d)
    seeders = d.get("seeders")
    if seeders is None: die("this site's manifest has no `seeders:` list (use `seeders: []` to allow a reset with no seeding)")
    b = do_backup(d)    # FIRST, and any failure aborts: nothing below runs without a verified backup
    say(f"backup verified: {b['path']}  size={b['size']}  sha256={b['sha256']}")
    artisan(d, "migrate:fresh", "--force"); say("migrate:fresh done")
    for s in seeders:
        artisan(d, "db:seed", f"--class={s}", "--force"); say(f"seeded {s}")
    for c in ("optimize:clear", "config:cache", "route:cache", "view:cache", "event:cache"): artisan(d, c)
    artisan(d, "queue:restart")
    say("caches rebuilt, queue workers restarted")
    result(ok=True, site=a.site, backup=b["path"], seeders=seeders)


# --- allow-listed tasks (run, bootstrap-admin) ----------------------------------------------------------------------------------------
def task_argv(d, name, values):
    tasks = d.get("tasks") or {}
    if name not in tasks: die(f"task '{name}' is not in this site's manifest `tasks:` (allowed: {', '.join(sorted(tasks)) or 'none'})")
    return expand_task(tasks[name], values)


@moded("run")
def cmd_run(a):
    d = load(a.site); need_laravel(d)
    argv = task_argv(d, a.task, parse_args_kv(a.arg))
    p = artisan(d, *argv, check=False)
    out = redact((p.stdout + p.stderr).strip())
    say(out[-3000:] if out else "(no output)")
    if p.returncode != 0: die(f"task '{a.task}' failed ({p.returncode})")
    result(ok=True, site=a.site, task=a.task)


@moded("bootstrap-admin")
def cmd_bootstrap_admin(a):
    d = load(a.site); need_laravel(d)
    vals = parse_args_kv(a.arg)
    if not vals.get("email") or not vals.get("name"): die("bootstrap-admin needs admin_email and admin_name")
    argv = task_argv(d, "super_admin", vals)
    p = artisan(d, *argv, check=False)
    full = p.stdout + p.stderr
    links = len(URL_RE.findall(full))
    # Whatever the command printed (possibly a set-password / invite link) goes to a ROOT-ONLY file on the server and nowhere else.
    path = priv("store-secret", a.site, "bootstrap-admin", data=full).stdout.strip() if full.strip() else ""
    if p.returncode != 0:
        say(redact(full.strip())[-1500:] or "(no output)"); die(f"the admin task failed ({p.returncode}); nothing was printed that could contain a link")
    say(f"admin task finished for {vals['email']}. {links} link(s) in its output were NOT printed." + (f" Full output, root-only: {path}" if path else ""))
    say("The admin should get an emailed invite / set-password link from the app; if the app printed one instead, read it from the file above (ssh as ops).")
    result(ok=True, site=a.site, secret_file=path or None, links=links)


@moded("tenancy-setup")
def cmd_tenancy_setup(a):
    """Install the origin certificate (stdin JSON {cert,key}, via the root helper), then (re-)register the site with its tenancy block so the
    Caddy file serves platform_host + the wildcard from one app root. Idempotent. Works before the first deploy (it registers the site)."""
    ten = parse_tenancy(json.loads(a.tenancy_json)) if a.tenancy_json else None
    if not ten: die("tenancy-setup needs a `tenancy:` block in .lunova.yml")
