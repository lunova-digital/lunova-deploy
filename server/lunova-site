        try: b = json.loads(blob); cert, key = b["cert"], b["key"]
        except (ValueError, KeyError, TypeError): die("certificate bundle must be JSON with `cert` and `key`")
        say(priv("install-cert", ten["tls_cert"], ten["root_domain"], data=json.dumps({"cert": cert, "key": key})).stdout.strip())
    else:
