PHP_DEFAULT = "8.3"
PHP_SHIMS = Path("/usr/local/lib/lunova/php")  # <ver>/php -> /usr/bin/php<ver>, created by ops/setup-php-versions


def php_ver(d): return str((d or {}).get("php") or PHP_DEFAULT)


def php_socket(ver=PHP_DEFAULT):
    # 8.3 keeps its legacy socket name so existing Caddy files stay valid; the others are /run/php/lunova-<ver>.sock
    if ver == PHP_DEFAULT: return cfg().get("php_socket", "/run/php/lunova.sock")
    return f"/run/php/lunova-{ver}.sock"


def php_bin(ver): return str(PHP_SHIMS / ver / "php")


def php_env(ver):
    """Environment that makes `php` (and composer, artisan, ...) resolve to the site's PHP version."""
    return {**os.environ, "PATH": f"{PHP_SHIMS / ver}:{os.environ.get('PATH', '')}"}


def covered_by(host, root):
    """True when a certificate for root and *.root covers this host (the apex or one label below it)."""
    return host == root or (host.endswith("." + root) and "." not in host[: -len(root) - 1].lstrip("*."))


def render_caddy(site, d):
    cur = f"/srv/sites/{site}/current"
    t = d["type"]
    if t in ("static", "spa"):
        body = f"\troot * {cur}/{d.get('root', '').strip('/')}".rstrip("/") + "\n\tencode zstd gzip\n"
        if t == "spa": body += "\ttry_files {path} /index.html\n"
        body += "\tfile_server\n"
    elif t in ("node", "python", "docker"):
        body = f"\tencode zstd gzip\n\treverse_proxy 127.0.0.1:{d['port']}\n"
    else:  # laravel
        body = (f"\troot * {cur}/public\n\tencode zstd gzip\n\tphp_fastcgi unix/{php_socket(php_ver(d))} {{\n"
                f"\t\tresolve_root_symlink\n\t}}\n\tfile_server\n")
    head = f"# managed by lunova-site (site: {site}, repo: {d.get('repo', '-')})\n"
    ten = d.get("tenancy")
    if not (ten and ten.get("wildcard")):
        hosts = ", ".join((f"http://{h}" if d.get("http_only") else h) for h in d["domains"])
        return f"{head}{hosts} {{\n{body}}}\n"
    # Tenancy: the platform host and the wildcard share ONE block (same app root) and use the origin certificate from /etc/caddy/certs
    # (a wildcard cannot be issued by Caddy's HTTP challenge). Any other domain of the site keeps Caddy's automatic certificates.
    root = ten["root_domain"]
    mine = [h for h in d["domains"] if h.startswith("*.") or covered_by(h, root)]
    rest = [h for h in d["domains"] if h not in mine]
    tls = f"\ttls {CERTS}/{ten['tls_cert']}.pem {CERTS}/{ten['tls_cert']}.key\n"
    out = f"{head}{', '.join(mine)} {{\n{tls}{body}}}\n"
    if rest: out += f"\n{', '.join(rest)} {{\n{body}}}\n"
    return out


def render_service_caddy(site, d, pw_hash):
    """Public face of an internal service: only the allow-listed admin paths, behind basic auth. Everything else is a 404."""
    pub = d["public"]
    paths = " ".join(pub["paths"])
    return (f"# managed by lunova-site (service {site}; admin paths only, message traffic stays internal)\n{pub['host']} {{\n"
            f"\tencode zstd gzip\n\t@admin path {paths}\n\thandle @admin {{\n\t\tbasicauth {{\n\t\t\t{pub['user']} {pw_hash}\n\t\t}}\n"
            f"\t\treverse_proxy 127.0.0.1:{d['host_port']}\n\t}}\n\thandle {{\n\t\trespond 404\n\t}}\n}}\n")


def render_unit(site, d):
    start = d["start"]
    return (f"[Unit]\nDescription=Lunova site {site}\nAfter=network.target\n\n[Service]\n"
            f"WorkingDirectory=/srv/sites/{site}/current\nEnvironmentFile=-/srv/sites/{site}/shared/.env\n"
            f"Environment=PORT={d['port']} HOST=127.0.0.1\nExecStart=/usr/bin/bash -c 'exec {start}'\n"
            f"Restart=on-failure\nRestartSec=3\n\n[Install]\nWantedBy=default.target\n")


def render_queue_unit(site, ver):
    return (f"[Unit]\nDescription=Lunova queue worker {site}\nAfter=network.target\n\n[Service]\n"
            f"WorkingDirectory=/srv/sites/{site}/current\n"
            f"ExecStart={php_bin(ver)} artisan queue:work --sleep=3 --tries=3 --max-time=3600\n"
            "Restart=always\nRestartSec=3\nMemoryMax=300M\n\n[Install]\nWantedBy=default.target\n")


def render_schedule_units(site, ver):
    svc = (f"[Unit]\nDescription=Lunova scheduler tick {site}\n\n[Service]\nType=oneshot\n"
           f"WorkingDirectory=/srv/sites/{site}/current\nExecStart={php_bin(ver)} artisan schedule:run\n")
    tmr = (f"[Unit]\nDescription=Lunova scheduler {site} (every minute)\n\n[Timer]\nOnCalendar=*-*-* *:*:00\n"
           "AccuracySec=1s\n\n[Install]\nWantedBy=timers.target\n")
    return svc, tmr


def sync_workers(site, d):
    """Create/remove the queue worker and scheduler timer according to the registry (laravel only)."""
    UNITS.mkdir(parents=True, exist_ok=True)
    q, sch = UNITS / f"site-{site}-queue.service", UNITS / f"site-{site}-schedule.service"
    tm = UNITS / f"site-{site}-schedule.timer"
    if d.get("queue") and d["type"] == "laravel":
        q.write_text(render_queue_unit(site, php_ver(d))); run(["systemctl", "--user", "enable", q.name], check=False)
    elif q.exists():
        run(["systemctl", "--user", "disable", "--now", q.name], check=False); q.unlink()
    if d.get("scheduler") and d["type"] == "laravel":
        svc, tmr = render_schedule_units(site, php_ver(d)); sch.write_text(svc); tm.write_text(tmr)
        run(["systemctl", "--user", "enable", tm.name], check=False)
    elif tm.exists():
        run(["systemctl", "--user", "disable", "--now", tm.name], check=False); tm.unlink(missing_ok=True); sch.unlink(missing_ok=True)
    run(["systemctl", "--user", "daemon-reload"])


def provision(pkgs):
    """Install packages this project needs (root helper validates names; nothing outside deployment tooling)."""
    pkgs = sorted(set(pkgs))
    if not pkgs: return
    say(f"provisioning packages: {' '.join(pkgs)}")
    p = run(["sudo", "-n", "/usr/local/sbin/lunova-provision", "install", *pkgs], check=False)
    if p.returncode != 0: die(f"could not install {' '.join(pkgs)}:\n{p.stdout}{p.stderr}")
    say(p.stdout.strip())


