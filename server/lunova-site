def die(msg, code=1):
    print(f"ERROR: {msg}", file=sys.stderr); sys.exit(code)


def say(msg): print(msg, flush=True)


def result(**kw): print("RESULT " + json.dumps(kw, sort_keys=True))


def run(cmd, cwd=None, check=True, shell=False, env=None):
    p = subprocess.run(cmd, cwd=cwd, shell=shell, text=True, capture_output=True, env=env)
    if check and p.returncode != 0:
        die(f"command failed ({p.returncode}): {cmd if shell else ' '.join(cmd)}\n{p.stdout}{p.stderr}")
    return p


def cfg():
    p = REG / "config.json"
    return json.loads(p.read_text()) if p.exists() else {}


def check_name(n):
    if not NAME_RE.match(n or "") or n in RESERVED:
        die(f"invalid site name '{n}': use lowercase letters, digits, hyphens (2-41 chars), not reserved")


def reg_path(site): return REG / "sites" / f"{site}.json"


def load(site, write=False):
    """Load a site. Through the gate, only the repo the site is bound to may touch it; changes only from its deploy branch."""
    p = reg_path(site)
    if not p.exists(): die(f"site '{site}' is not registered (run: lunova-site register ...)")
    d = json.loads(p.read_text())
    if WHO:
        if d.get("repo") != WHO: die(f"site '{site}' belongs to another repository")
        if write and d.get("branch") and REF != f"refs/heads/{d['branch']}":
            die(f"site '{site}' deploys from branch '{d['branch']}' only (this run is {REF or 'unknown'})")
    return d


def save(site, data):
    (REG / "sites").mkdir(parents=True, exist_ok=True)
    tmp = reg_path(site).with_suffix(".tmp"); tmp.write_text(json.dumps(data, indent=2, sort_keys=True)); tmp.replace(reg_path(site))


def all_sites():
    d = REG / "sites"
    return {p.stem: json.loads(p.read_text()) for p in sorted(d.glob("*.json"))} if d.exists() else {}


def listening_ports():
    out = run(["ss", "-ltnH"], check=False).stdout
    return {int(m.group(1)) for m in re.finditer(r":(\d+)\s", out)}


def caddy_reload(): run(["sudo", "-n", "/usr/local/sbin/caddy-reload"])


def container(*args, check=True):
    """The root helper that runs an allow-listed container (service sites only)."""
    return run(["sudo", "-n", CONTAINER, *args], check=check)


# --- type: docker (a public site whose app is a container built in CI from the project's own Dockerfile) -----------------
# Runs in ROOTLESS Docker owned by `deploy` (never the root daemon used by `service`): a container escape is `deploy`, not root.
DOCKER_SOCK = f"/run/user/{os.getuid()}/docker.sock"
VOLUME_RE = re.compile(r"^[a-z][a-z0-9_-]{0,30}:/[A-Za-z0-9._/-]{0,200}$")


DOCKER_BIN = shutil.which("docker") or str(Path.home() / "bin/docker")  # rootless install puts the CLI in ~deploy/bin


def docker_ready(): return os.access(DOCKER_BIN, os.X_OK) and os.path.exists(DOCKER_SOCK)


def dk(*args, check=True, env=None):
    """docker CLI against deploy's rootless daemon."""
    e = {**os.environ, "DOCKER_HOST": f"unix://{DOCKER_SOCK}", **(env or {})}
    return run([DOCKER_BIN, *args], check=check, env=e)


def cname(site): return f"lunova-{site}"


def itag(site, rid): return f"lunova-{site}:{rid}"


def unquote_env(v):
    v = v.strip()
    if len(v) >= 2 and v[0] == v[-1] == '"':
        return re.sub(r"\\(.)", lambda m: "\n" if m.group(1) == "n" else m.group(1), v[1:-1])
    return v


def docker_env(site, d):
    """PORT default < manifest env < sealed env (+ nothing else). Passed via the process environment, never written to disk or argv."""
    out = {"PORT": str(d["container_port"]), **(d.get("env") or {})}
    f = SITES / site / "shared" / ".env"
    if f.exists():
        for k, v in parse_env(f.read_text()).items(): out[k] = unquote_env(v)
    return out


def docker_load(site, rel, rid):
    """Load the CI-built image. The archive may only contain exactly lunova-<site>:<release>, so it cannot overwrite anything else."""
    tar = rel / "image.tar.gz"
    if not tar.exists(): die(f"release {rid} has no image.tar.gz (the CI image build/upload did not happen)")
    p = dk("load", "-i", str(tar))
    loaded = [l.split(": ", 1)[1].strip() for l in p.stdout.splitlines() if l.startswith("Loaded image: ")]
    if loaded != [itag(site, rid)] or "Loaded image ID" in p.stdout:
        for t in loaded: dk("rmi", t, check=False)
        die(f"image archive must contain exactly {itag(site, rid)} (found: {', '.join(loaded) or 'untagged image'})")


def docker_up(site, d, rid):
    """(Re)create the site's container from the release's image (loads it again from the release's archive if the image is gone)."""
    rel = SITES / site / "releases" / rid
    if dk("image", "inspect", itag(site, rid), check=False).returncode != 0: docker_load(site, rel, rid)
    dk("rm", "-f", cname(site), check=False)
    env = docker_env(site, d)
    args = ["run", "-d", "--name", cname(site), "--restart", "unless-stopped", "--label", f"lunova.site={site}", "--label", f"lunova.release={rid}",
            "-p", f"127.0.0.1:{d['port']}:{d['container_port']}", "--memory", f"{int(d.get('memory_mb') or 512)}m",
            "--pids-limit", "512", "--security-opt", "no-new-privileges"]
    for v in d.get("volumes") or []:
        name, _, path = v.partition(":"); args += ["-v", f"lunova-{site}-{name}:{path}"]
    for k in env: args += ["-e", k]
    args.append(itag(site, rid))
    p = dk(*args, check=False, env=env)
    if p.returncode != 0: say((p.stdout + p.stderr)[-1500:]); return False
    return True


def prune_images(site):
    keep = {itag(site, r.name) for r in releases(site)}
    for t in dk("images", "--format", "{{.Repository}}:{{.Tag}}", f"lunova-{site}", check=False).stdout.split():
        if t not in keep: dk("rmi", t, check=False)


def release_docker(a, d, rel):
    """Load the CI-built image, swap the container, health-check, switch; any failure puts the previous container back."""
    if not docker_ready(): die("rootless Docker is not enabled on this server: ops request #7 (run ops/setup-docker-rootless)")
    build_env(a.site)
    docker_load(a.site, rel, a.id)
    prev = current_target(a.site)
    had = dk("inspect", cname(a.site), check=False).returncode == 0
    if had: dk("stop", "-t", "20", cname(a.site), check=False); dk("rename", cname(a.site), cname(a.site) + "-prev")

    def restore():
        dk("rm", "-f", cname(a.site), check=False)
        if had: dk("rename", cname(a.site) + "-prev", cname(a.site), check=False); dk("start", cname(a.site), check=False); say("previous container restored")
    if not docker_up(a.site, d, a.id):
        restore(); result(ok=False, site=a.site, release=a.id, error="container did not start", rolled_back=had); sys.exit(3)
    code, url = health(a.site, d)
    if not (isinstance(code, int) and 200 <= code < 400):
        say(f"health check failed ({code}) at {url}")
        say(dk("logs", "--tail", "40", cname(a.site), check=False).stdout)
        restore(); result(ok=False, site=a.site, release=a.id, health=str(code), rolled_back=had); sys.exit(3)
    switch(a.site, rel)
    dk("rm", "-f", cname(a.site) + "-prev", check=False)
    (rel / ".lunova-ok").write_text(str(int(time.time())))
    good = sorted((r for r in releases(a.site) if ok_ts(r)), key=ok_ts)
    keep = {str(r) for r in good[-KEEP:]} | {current_target(a.site)}
    for old in releases(a.site):
        if str(old) not in keep: shutil.rmtree(old, ignore_errors=True)
    prune_images(a.site)
    say(f"released {a.site} {a.id} (health {code}) -> container on 127.0.0.1:{d['port']}")
    result(ok=True, site=a.site, release=a.id, health=code, domains=d["domains"])


def service_spec(d):
    """What the container needs to run, kept inside each release so a rollback restarts exactly that release's configuration."""
    return {k: d.get(k) for k in ("image", "container_port", "host_port", "env", "volumes", "memory_mb")}


